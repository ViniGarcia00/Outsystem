// Outmat Propostas — Prisma schema (Sprint 0)
//
// IMPORTANTE (Sprint 0): os models são APENAS ESTRUTURAIS.
// Não há regras de negócio nem os campos de domínio definitivos.
// Cada model carrega somente id, timestamps, o vínculo relacional essencial
// e, quando faz sentido, um identificador `nome` (necessário para o seed/tabelas).
// A expansão dos campos ocorrerá nas próximas Sprints via migrations incrementais,
// sem alteração estrutural das camadas da aplicação.
//
// Docs de arquitetura: ARCHITECTURE.md

generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

// ---------------------------------------------------------------------------
// Enums
// ---------------------------------------------------------------------------

/// Discriminador do modelo de proposta.
/// COMERCIAL    -> produtos + serviços + módulos opcionais (ex.: Wi-Fi, Som).
/// SIMPLIFICADA -> apenas produtos (nunca serviços, nunca módulos).
/// As regras de negócio serão implementadas nas próximas Sprints.
enum ModeloProposta {
  COMERCIAL
  SIMPLIFICADA
}

/// Tipo de pessoa do cliente.
enum TipoPessoa {
  PF
  PJ
}

/// Status oficiais da proposta (ciclo de vida). Ver DECISIONS.md ADR-0204.
///
/// `APROVADA` (Sprint 4.3, ADR-0412) é a **projeção** de "a revisão ATUAL está
/// aprovada" — o FATO mora em `PropostaRevisao.aprovadaEm`. Existe como coluna
/// porque listagem, filtro, badge e dashboard já leem `Proposta.status`, e
/// derivar isso por join em toda listagem seria caro.
enum StatusProposta {
  RASCUNHO
  EMITIDA
  APROVADA
  CANCELADA
}

/// Motivo do cancelamento (obrigatório ao cancelar). ADR-0203.
enum MotivoCancelamento {
  CLIENTE_DESISTIU
  CONCORRENCIA
  PROJETO_CANCELADO
  ERRO_PROPOSTA
  PROPOSTA_SUBSTITUIDA
  OUTRO
}

/// Eventos de auditoria da proposta. ADR-0204.
enum EventoAuditoria {
  CRIACAO
  ALTERACAO
  NOVA_REVISAO
  DUPLICACAO
  MUDANCA_STATUS
  EMISSAO
  CANCELAMENTO
}

/// Tipo de item da revisão. Nesta Sprint só PRODUTO é usado; SERVICO já
/// preparado para a próxima Sprint (ADR-0207).
enum TipoItemProposta {
  PRODUTO
  SERVICO
}

/// Como o desconto da proposta é interpretado (ADR-0220).
enum TipoDesconto {
  VALOR
  PERCENTUAL
}

/// Tipo do serviço complementar da proposta (Sprint 2.9.1). Estrutura preparada
/// para receber novos tipos no futuro SEM alteração de banco. NÃO representa o
/// "Projeto de Automação" (que é o Conteúdo/Revisão) — é uma entidade paralela.
enum TipoServicoProposta {
  SOM
  WIFI
}

// ---------------------------------------------------------------------------
// Instalações (Sprint 4.0.1) — módulo operacional
// ---------------------------------------------------------------------------

/// Estado operacional da instalação. Cancelada NUNCA é excluída (ADR-0400).
enum StatusInstalacao {
  A_AGENDAR
  AGENDADA
  AGUARDANDO_MATERIAL
  EM_ANDAMENTO
  ADIADA
  CONCLUIDA
  CANCELADA
}

/// Trilha TÉCNICA da instalação. Não confundir com a cronologia operacional
/// (InstalacaoRegistro, Sprint 4.0.2) — ver ADR-0400.
enum EventoInstalacao {
  CRIACAO
  ALTERACAO
  MUDANCA_STATUS
  CANCELAMENTO
}

/// Tipo do acontecimento na cronologia operacional (Sprint 4.0.2).
enum TipoRegistroInstalacao {
  VISITA_CLIENTE
  ATUALIZACAO_INTERNA
  MATERIAL_COMPRADO
  ALTERACAO_ESCOPO
  PENDENCIA
  CONCLUSAO
  OUTRO
}

/// Categoria do custo extra do acontecimento (Sprint 4.0.2).
enum CategoriaCustoInstalacao {
  MATERIAL
  MAO_DE_OBRA
  DESLOCAMENTO
  TERCEIROS
  FRETE
  OUTROS
}

// ---------------------------------------------------------------------------
// Cadastros base
// ---------------------------------------------------------------------------

model Cliente {
  id         String     @id @default(cuid())
  ativo      Boolean    @default(true)
  tipoPessoa TipoPessoa @default(PF)

  /// Obrigatório quando PF (validado no Zod).
  nome    String?
  /// Obrigatório quando PJ (validado no Zod).
  empresa String?

  /// Opcional; ÚNICO quando informado (nulos não conflitam no PostgreSQL).
  cpfCnpj String? @unique

  /// Documento secundário opcional (ADR-0224): RG (PF) ou Inscrição Estadual
  /// (PJ). Exibido conforme o tipo de pessoa; sem unicidade.
  rg                String?
  inscricaoEstadual String?

  cep         String?
  endereco    String?
  numero      String?
  complemento String?
  bairro      String?
  cidade      String?
  estado      String?

  telefone    String?
  email       String?
  observacoes String? @db.Text

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  propostas   Proposta[]
  instalacoes Instalacao[]

  /// Pós-venda (Sprint 4.6). Lado inverso apenas — não gera DDL. As FKs são
  /// RESTRICT: cliente usado em Troca ou OS nunca é excluído.
  trocasAntecipadas TrocaAntecipada[]
  ordensServico     OrdemServicoPosVenda[]

  @@index([ativo])
  @@map("clientes")
}

model Produto {
  id           String  @id @default(cuid())
  ativo        Boolean @default(true)
  codigo       String  @unique
  descricao    String
  /// Unidade de medida (UN, MT, CX, RL, L, KG…). Origem do snapshot do item.
  unidade      String  @default("UN")
  valorProduto Decimal @db.Decimal(12, 2)
  /// Pode ser zero.
  valorServico Decimal @db.Decimal(12, 2)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  /// Itens de proposta que referenciam este produto (regra de exclusão ADR-0104).
  itens PropostaItem[]

  /// Itens de Pós-venda (Sprint 4.6). Mesma regra: RESTRICT, produto usado não
  /// é excluído. É o vínculo que torna possível, no futuro, analisar defeito
  /// recorrente por produto.
  trocaItens        TrocaAntecipadaItem[]
  ordemServicoItens OrdemServicoPosVendaItem[]

  @@index([ativo])
  @@map("produtos")
}

/// Usuario — pessoa que atua na operação, com PAPÉIS independentes (ADR-0410).
///
/// Substitui os cadastros separados de Vendedor e Técnico (supersede parcial do
/// ADR-0408). A mesma pessoa pode ser vendedora, técnica, ambas ou nenhuma —
/// antes era preciso cadastrá-la duas vezes, e nada mantinha as duas coerentes.
///
/// **NÃO é principal de autenticação.** Não há login, senha, permissão nem
/// agenda. Quando o sistema ganhar autenticação, "registrado por" será campo
/// NOVO e aditivo, separado destes vínculos: `vendedorId`/`tecnicoId` respondem
/// QUEM FEZ o trabalho, não quem digitou.
///
/// `ativo` e os papéis são eixos INDEPENDENTES: `ativo` diz se a pessoa ainda
/// atua; os papéis dizem o que ela faz. Disponível para um vínculo NOVO naquele
/// papel = `ativo && ehPapel`. Usuário sem papel nenhum é válido — é o cadastro
/// criado antes de a função ser decidida; ele só não aparece em select nenhum.
model Usuario {
  id         String  @id @default(cuid())
  ativo      Boolean @default(true)
  nome       String
  /// Papel comercial. Filtra o Select de Vendedor da Proposta.
  ehVendedor Boolean @default(false)
  /// Papel operacional. Filtra os Selects de Técnico das Instalações.
  ehTecnico  Boolean @default(false)
  telefone   String?
  email      String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  /// Relações NOMEADAS: são três para o mesmo model, e o Prisma exige o nome
  /// explícito quando há mais de uma entre os mesmos dois models.
  propostasComoVendedor Proposta[]           @relation("PropostaVendedor")
  instalacoes           Instalacao[]         @relation("InstalacaoTecnico")
  registros             InstalacaoRegistro[] @relation("RegistroTecnico")

  /// Pós-venda (Sprint 4.6). Quatro vínculos NOVOS, todos RESTRICT — o mesmo
  /// tratamento dos três acima. `removeUsuario` passa a contar as SETE
  /// relações; sem isso, excluir um usuário usado no Pós-venda devolveria erro
  /// cru de FK em vez da mensagem que orienta a inativar.
  ///
  /// Nenhum papel novo foi criado: o responsável de Pós-venda usa `ehTecnico`.
  trocasAntecipadas     TrocaAntecipada[]              @relation("TrocaResponsavel")
  trocaRegistros        TrocaAntecipadaRegistro[]      @relation("TrocaRegistroResponsavel")
  ordensServico         OrdemServicoPosVenda[]         @relation("OrdemServicoResponsavel")
  ordemServicoRegistros OrdemServicoPosVendaRegistro[] @relation("OrdemServicoRegistroResponsavel")

  @@index([ativo])
  @@map("usuarios")
}

// ---------------------------------------------------------------------------
// Propostas — hierarquia: Proposta > Revisão > Seção > Item
// ---------------------------------------------------------------------------

model Proposta {
  id String @id @default(cuid())

  /// Numeração sequencial da proposta (sequência do PostgreSQL, inicia em 1001).
  /// Nunca reutilizada; canceladas mantêm o número. Ver DECISIONS.md ADR-0201.
  proposalNumber Int @unique @default(autoincrement())

  /// Tipo/modelo da proposta (apenas persistência nesta Sprint). ADR-0205.
  modelo ModeloProposta @default(COMERCIAL)

  /// Ciclo de vida (ADR-0204). Cancelada apenas via ação Cancelar (ADR-0203).
  status StatusProposta @default(RASCUNHO)

  /// Nome do projeto (ADR-0227). Texto livre pertencente à Proposta.
  nomeProjeto String?

  /// Validade em dias (nasce com 5; usuário pode alterar).
  validadeDias Int @default(5)

  /// Observações internas (NUNCA no PDF/cliente).
  obsInternas String? @db.Text
  /// Observações da proposta (futuro PDF).
  obsProposta String? @db.Text

  /// Desconto da proposta (ADR-0220). Modelagem separada de tipo/valor; o total
  /// é derivado (nunca persistido). Congelamento por-revisão fica para o PDF.
  tipoDesconto  TipoDesconto @default(VALOR)
  valorDesconto Decimal      @default(0) @db.Decimal(12, 2)

  /// Frete da proposta (ADR-0221). Valor informado manualmente (≥ 0); compõe o
  /// Total da Proposta (derivado, nunca persistido).
  frete Decimal @default(0) @db.Decimal(12, 2)

  /// Informações comerciais finais da proposta (ADR-0222). Texto livre; não
  /// entram em cálculo/total. Serão usadas no PDF (Sprint 2.7).
  /// `previsaoInstalacao` só é exibido no modelo Completa (apresentação).
  formaPagamento     String? @db.Text
  previsaoInstalacao String? @db.Text
  /// Observações comerciais e técnicas (multilinha; futuro PDF).
  obsComerciais      String? @db.Text
  obsTecnicas        String? @db.Text

  // --- Campos CONTRATUAIS (Sprint 4.4, ADR-0416) -----------------------------
  // Alimentam o contrato Rev. 4 e nada mais. Ficam aqui, no bloco de
  // finalização, porque é onde já vivem `formaPagamento` e `previsaoInstalacao`.
  // Ver a dívida registrada no ADR-0415: campos de cabeçalho NÃO são históricos
  // por revisão — são sobrescritos no fork.

  /// Prazo CONTRATUAL de execução, em dias úteis (cláusula 3.1 da Rev. 4).
  ///
  /// **Não confundir com `previsaoInstalacao`**, que é texto livre comercial
  /// ("3 dias", "a combinar") exibido nos PDFs. Este é número, é prazo de
  /// CONCLUSÃO e é cláusula — o template já traz "dias úteis" ao lado da tag.
  ///
  /// Nullable para retrocompatibilidade; obrigatório para gerar contrato Rev. 4.
  prazoExecucaoDiasUteis Int?

  /// Parcela final exigível no aceite (Anexo II da Rev. 4).
  ///
  /// **Informada, nunca derivada.** `formaPagamento` é texto livre e o sistema
  /// não tem estrutura de parcelas nem registro de valor recebido — extrair
  /// isto de uma frase por regex seria frágil num documento que vai para
  /// assinatura (ADR-0416). Decimal, nunca Float.
  valorParcelaFinal Decimal? @db.Decimal(12, 2)

  /// Observações do Termo de Aceite (Anexo II). Substitui o último placeholder
  /// manual do contrato, o `[se houver]`.
  ///
  /// **NÃO é `obsInternas`**, que é anotação de negociação e nunca sai do
  /// sistema (ADR-0203) — colocá-la num documento assinado seria vazamento.
  observacoesAceite String? @db.Text

  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt
  /// Datas de status — carimbadas apenas na 1ª transição; nunca sobrescritas.
  emitidaAt   DateTime?
  canceladaAt DateTime?

  /// Cancelamento (ADR-0203). obsCancelamento obrigatório quando OUTRO.
  motivoCancelamento MotivoCancelamento?
  obsCancelamento    String?             @db.Text

  /// Cliente pode ser nulo APENAS enquanto o rascunho está sendo montado
  /// (fluxo workspace-first). Regra de negócio: proposta válida/emitida SEMPRE
  /// tem cliente — garantido pela guarda de emissão. ADR-0210+ (refino 2.3).
  clienteId  String?
  cliente    Cliente? @relation(fields: [clienteId], references: [id])
  /// Usuário que atua como VENDEDOR nesta proposta (ADR-0410). A coluna nomeia
  /// o PAPEL no vínculo, não a tabela de origem — por isso o nome não mudou
  /// quando `Vendedor` virou `Usuario`, e o mapper do PDF segue intacto.
  /// Restrict: vendedor vinculado nunca é apagado, e o vínculo nunca é zerado
  /// em silêncio (antes era SET NULL — corrigido nesta Sprint).
  vendedorId String?
  vendedor   Usuario? @relation("PropostaVendedor", fields: [vendedorId], references: [id], onDelete: Restrict)

  /// Aponta para a revisão ATUAL da proposta (evita consultar/recalcular a
  /// última revisão a cada acesso). Relacionamento 1:1 opcional.
  currentRevisionId String?          @unique
  currentRevision   PropostaRevisao? @relation("PropostaRevisaoAtual", fields: [currentRevisionId], references: [id])

  revisoes   PropostaRevisao[]   @relation("PropostaRevisoes")
  auditorias PropostaAuditoria[]

  /// Serviços complementares (Sprint 2.9.1). Pertencem à Proposta (não à
  /// revisão) e NÃO entram nos cálculos da proposta nesta Sprint.
  servicos PropostaServico[]

  /// Vínculo OPCIONAL do módulo operacional (Sprint 4.0.1). A Instalação pode
  /// existir sem Proposta; associar NÃO importa itens nem sincroniza nada.
  instalacoes Instalacao[]

  @@index([clienteId])
  @@index([vendedorId])
  @@index([status])
  @@map("propostas")
}

/// Trilha de auditoria da proposta (sem tela nesta Sprint). ADR-0204.
model PropostaAuditoria {
  id String @id @default(cuid())

  propostaId String
  proposta   Proposta @relation(fields: [propostaId], references: [id], onDelete: Cascade)

  evento         EventoAuditoria
  /// Número da revisão vigente no momento do evento (quando aplicável).
  revisionNumber Int?
  observacao     String?         @db.Text

  createdAt DateTime @default(now())

  @@index([propostaId])
  @@map("proposta_auditorias")
}

model PropostaRevisao {
  id String @id @default(cuid())

  /// Número inteiro da revisão (0, 1, 2, ...). O banco guarda APENAS o inteiro;
  /// a interface é responsável por exibir "Rev.0", "Rev.1" etc.
  revisionNumber Int

  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt
  /// Momento em que ESTA revisão foi emitida (Gerar PDF). Congela a versão e
  /// alimenta o histórico/PDF por revisão. Null enquanto rascunho.
  ///
  /// É o gatilho do fork em `salvarProposta` (ADR-0412): revisão congelada
  /// nunca é alterada in-place. Não usar `Proposta.status` para essa decisão.
  emittedAt DateTime?

  /// Momento em que o cliente aprovou ESTE conteúdo (Sprint 4.3, ADR-0412).
  ///
  /// FATO HISTÓRICO por revisão, simétrico a `emittedAt`. Uma vez gravado, não
  /// é reescrito por edição: alterar a proposta cria a Rev.N+1 (que nasce com
  /// `aprovadaEm` nulo) e esta revisão segue registrando o que foi aprovado e
  /// quando. A ÚNICA operação que o limpa é a ação "Desfazer aprovação", e só
  /// sobre a revisão ATUAL — revisões anteriores são imutáveis.
  ///
  /// `Proposta.status = APROVADA` é a projeção disto para a revisão atual.
  /// NÃO existe `Proposta.aprovadaAt` — a resposta certa é sempre por revisão.
  aprovadaEm DateTime?

  /// Versão do template de contrato vigente quando ESTA revisão foi emitida
  /// (Sprint 4.4, ADR-0415). Carimbada em `emitirProposta`, junto de
  /// `emittedAt`, e NUNCA reescrita — congela o texto jurídico do mesmo jeito
  /// que `emittedAt` congela o conteúdo comercial.
  ///
  /// É o que impede um contrato antigo de mudar de redação quando o template é
  /// trocado: o renderer escolhe o arquivo por ESTE valor, não pelo vigente.
  ///
  /// `null` = revisão nunca emitida, ou emitida antes deste campo existir; nos
  /// dois casos o renderer assume `rev3` (`TEMPLATE_CONTRATO_PADRAO`). Não há
  /// backfill de propósito: preencher retroativamente seria afirmar uma versão
  /// que ninguém registrou.
  templateContratoVersao String?

  propostaId String
  proposta   Proposta @relation("PropostaRevisoes", fields: [propostaId], references: [id], onDelete: Cascade)

  /// Back-relation do vínculo "revisão atual" em Proposta.
  propostaAtual Proposta? @relation("PropostaRevisaoAtual")

  secoes PropostaSecao[]

  @@unique([propostaId, revisionNumber])
  @@index([propostaId])
  @@map("proposta_revisoes")
}

/// Seção = agrupador NEUTRO de itens.
/// Exemplos válidos: "Sala", "Cozinha", "Casa 92", "Apartamento Flávio",
/// "Área Externa", "Recepção", "Piso Superior".
/// NÃO representa obrigatoriamente um "ambiente" — NUNCA tratar como Ambiente internamente.
model PropostaSecao {
  id        String   @id @default(cuid())
  /// Nome do agrupador NEUTRO (ex.: "Sala", "Cozinha"). Nunca "Ambiente".
  nome      String
  /// Ordem contígua (0,1,2…) dentro da revisão. ADR-0208.
  ordem     Int      @default(0)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  revisaoId String
  revisao   PropostaRevisao @relation(fields: [revisaoId], references: [id], onDelete: Cascade)

  itens PropostaItem[]

  @@index([revisaoId])
  @@map("proposta_secoes")
}

model PropostaItem {
  id        String           @id @default(cuid())
  tipo      TipoItemProposta @default(PRODUTO)
  createdAt DateTime         @default(now())
  updatedAt DateTime         @updatedAt

  secaoId String
  secao   PropostaSecao @relation(fields: [secaoId], references: [id], onDelete: Cascade)

  /// Vínculo com o cadastro (navegável). RESTRICT: produto usado não é excluído
  /// (ADR-0104/0207). Itens de PRODUTO sempre preenchem; nulo previsto p/ SERVICO.
  produtoId String?
  produto   Produto? @relation(fields: [produtoId], references: [id], onDelete: Restrict)

  /// Snapshot imutável do produto no momento (ADR-0207).
  codigo       String
  descricao    String
  unidade      String
  valorProduto Decimal @db.Decimal(12, 2)
  valorServico Decimal @db.Decimal(12, 2)

  /// Quantidade (permite frações — cabo, metros, litros…).
  quantidade Decimal @default(1) @db.Decimal(12, 3)
  /// Ordem contígua (0,1,2…) dentro da seção. ADR-0208.
  ordem      Int     @default(0)

  @@index([secaoId])
  @@index([produtoId])
  @@map("proposta_itens")
}

/// Serviço complementar da proposta (Sprint 2.9.1). Entidade única e genérica
/// para qualquer tipo de serviço (hoje SOM e WIFI); novos tipos entram só no
/// enum, sem mudança estrutural. Independente do Conteúdo/Automação e do PDF.
/// Nesta Sprint NÃO entra em subtotal/desconto/frete/total (isso fica p/ 2.9.2).
/// `valorTotal` é gravado (produtos + serviços), calculado no servidor.
/// Único por (proposta, tipo): no máximo um SOM e um WIFI por proposta.
model PropostaServico {
  id String @id @default(cuid())

  propostaId String
  proposta   Proposta @relation(fields: [propostaId], references: [id], onDelete: Cascade)

  tipo      TipoServicoProposta
  descricao String?             @db.Text

  valorProdutos Decimal @default(0) @db.Decimal(12, 2)
  valorServicos Decimal @default(0) @db.Decimal(12, 2)
  /// Derivado (produtos + serviços); persistido por decisão da Sprint 2.9.1.
  valorTotal    Decimal @default(0) @db.Decimal(12, 2)

  /// Ordem contígua (0,1,2…) de exibição dentro da proposta.
  ordem     Int      @default(0)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([propostaId, tipo])
  @@index([propostaId])
  @@map("proposta_servicos")
}

// ---------------------------------------------------------------------------
// Configuração do sistema — SINGLETON (existe apenas UM registro)
// ---------------------------------------------------------------------------

/// Registro único de configuração da aplicação.
/// Ponto ÚNICO de expansão futura, SEM alteração estrutural de camadas:
/// dados da empresa, logo, endereço, telefones, WhatsApp, email, site,
/// redes sociais, rodapé do PDF, textos institucionais, templates,
/// caminhos de armazenamento e configurações gerais.
/// Esses campos serão adicionados nas próximas Sprints via migration incremental.
model ConfiguracaoSistema {
  /// id fixo garante a natureza singleton (sempre "singleton").
  id String @id @default("singleton")

  // Dados da empresa
  nomeEmpresa       String?
  razaoSocial       String?
  cnpj              String?
  /// Inscrição Estadual da empresa (ADR-0225).
  inscricaoEstadual String?

  // Endereço
  cep         String?
  endereco    String?
  numero      String?
  complemento String?
  bairro      String?
  cidade      String?
  estado      String?

  // Contatos
  telefone String?
  whatsapp String?
  email    String?
  site     String?

  // Identidade visual
  logo          String?
  corPrimaria   String?
  corSecundaria String?

  // Textos institucionais
  textoQuemSomos     String? @db.Text
  textoFinalProposta String? @db.Text

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@map("configuracao_sistema")
}

// ---------------------------------------------------------------------------
// Instalações — módulo operacional (Sprint 4.0.1)
// ---------------------------------------------------------------------------

/// Instalação — raiz do agregado operacional.
///
/// Independente de Pedido de Venda: existe por cadastro manual. O endereço é
/// SNAPSHOT do Cliente no momento da criação, derivado no service a partir do
/// registro persistido — alterar o cadastro do Cliente depois NÃO muda
/// instalações antigas (ADR-0400).
model Instalacao {
  id String @id @default(cuid())

  /// Numeração COMERCIAL (sequência própria, inicia em 1001). Nunca usar o id.
  numero Int @unique @default(autoincrement())

  clienteId String
  cliente   Cliente @relation(fields: [clienteId], references: [id])

  /// Identificação operacional da obra, dada pelo usuário (Sprint 4.3,
  /// ADR-0413). Ex.: "Casa Alphaville", "Apartamento Moema" — o mesmo cliente
  /// pode ter várias instalações, e é o apelido que as distingue na listagem.
  ///
  /// Pertence à INSTALAÇÃO, nunca ao Cliente. Nasce sugerido pelo nome de
  /// exibição do Cliente na criação, mas é editável a qualquer momento: é
  /// rótulo operacional, **não é snapshot** — não seguir a regra do endereço.
  ///
  /// NÃO é o `nomeProjeto` removido na Sprint 4.0.3 (ADR-0404). Aquele era
  /// texto solto, sem regra e sem papel na identificação; a remoção dele
  /// continua correta. Esta coluna é nova.
  ///
  /// Nullable no banco (o backfill preencheu as linhas antigas), obrigatório no
  /// Zod: constraint dura num campo de rótulo não paga o custo.
  apelido String?

  /// Vínculo OPCIONAL. Não importa itens nem sincroniza nada.
  propostaId String?
  proposta   Proposta? @relation(fields: [propostaId], references: [id], onDelete: Restrict)

  /// Responsável ATUAL — estado corrente, não fato histórico. Renomear o
  /// Usuário DEVE refletir aqui; por isso não há snapshot textual (ADR-0408).
  /// Aponta para `Usuario` com papel de técnico (ADR-0410).
  tecnicoResponsavelId String?
  tecnicoResponsavel   Usuario? @relation("InstalacaoTecnico", fields: [tecnicoResponsavelId], references: [id], onDelete: Restrict)

  status StatusInstalacao @default(A_AGENDAR)

  // Snapshot do endereço do Cliente. `enderecoNumero` evita colisão com `numero`.
  cep                String?
  enderecoLogradouro String?
  enderecoNumero     String?
  complemento        String?
  bairro             String?
  cidade             String?
  estado             String?

  dataPrevista DateTime?
  dataAgendada DateTime?
  periodo      String?
  observacoes  String?   @db.Text

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  auditorias InstalacaoAuditoria[]
  registros  InstalacaoRegistro[]

  @@index([clienteId])
  @@index([status])
  @@index([tecnicoResponsavelId])
  @@map("instalacoes")
}

/// Trilha técnica da instalação. Gravada na MESMA transação da escrita, como
/// PropostaAuditoria. NÃO confundir com a cronologia operacional (Sprint 4.0.2).
model InstalacaoAuditoria {
  id String @id @default(cuid())

  instalacaoId String
  instalacao   Instalacao @relation(fields: [instalacaoId], references: [id], onDelete: Cascade)

  evento     EventoInstalacao
  observacao String?          @db.Text

  createdAt DateTime @default(now())

  @@index([instalacaoId])
  @@map("instalacao_auditorias")
}

/// Acontecimento da cronologia operacional (Sprint 4.0.2).
///
/// É CONTEÚDO escrito pelos responsáveis, não trilha de sistema — não confundir
/// com InstalacaoAuditoria (ADR-0401). Criar, editar ou excluir um registro NÃO
/// gera entrada de auditoria.
model InstalacaoRegistro {
  id String @id @default(cuid())

  instalacaoId String
  instalacao   Instalacao @relation(fields: [instalacaoId], references: [id], onDelete: Cascade)

  tipo TipoRegistroInstalacao

  /// Quando o fato OCORREU. Pode ser anterior à criação da instalação (fatos
  /// históricos são permitidos). A timeline ordena por este campo.
  aconteceuEm DateTime

  /// Quem executou/acompanhou — `Usuario` com papel de técnico (ADR-0410).
  /// RESTRICT: usuário usado na cronologia nunca é apagado.
  tecnicoId String
  tecnico   Usuario @relation("RegistroTecnico", fields: [tecnicoId], references: [id], onDelete: Restrict)

  /// Snapshot do nome do Técnico no momento em que ELE foi atribuído a este
  /// registro. Derivado NO SERVICE a partir do Usuario persistido — nunca
  /// recebido do navegador (mesma regra do endereço, ADR-0400).
  ///
  /// NÃO é reescrito em edição comum: só quando o `tecnicoId` muda. Ver §6.2 da
  /// spec e o ADR-0408.
  responsavelNome String

  relatorio String @db.Text

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  custos InstalacaoCusto[]
  anexos InstalacaoRegistroAnexo[]

  @@index([instalacaoId, aconteceuEm])
  @@index([tecnicoId])
  @@map("instalacao_registros")
}

/// Arquivo anexado a um acontecimento da cronologia (Sprint 4.3, ADR-0414).
///
/// **O banco é a autoridade.** Arquivo órfão em disco é tolerado e logável;
/// linha apontando para arquivo inexistente é o estado a evitar. É essa
/// assimetria que fixa a ordem das operações: no upload grava-se o arquivo e
/// DEPOIS a linha; na exclusão apaga-se a linha e DEPOIS o arquivo.
///
/// 1:N desde o início: 1:1 custaria uma remodelagem na primeira vez que alguém
/// anexasse duas fotos, e "duas fotos" é o caso normal de uma visita.
model InstalacaoRegistroAnexo {
  id String @id @default(cuid())

  registroId String
  registro   InstalacaoRegistro @relation(fields: [registroId], references: [id], onDelete: Cascade)

  /// Nome que o usuário enviou. Exibição e `Content-Disposition` apenas —
  /// **NUNCA** participa da construção de um caminho físico.
  nomeOriginal    String
  /// Chave física gerada no SERVIDOR: `<cuid>.<ext>`, com a extensão vinda da
  /// allowlist de MIME, nunca do nome enviado pelo navegador.
  nomeArmazenado  String
  /// Caminho RELATIVO a `storagePaths.upload`, com separadores POSIX. Caminho
  /// absoluto nunca é persistido: depende do servidor e de `UPLOAD_PATH`, que
  /// mudam entre ambientes.
  caminhoRelativo String
  /// MIME da allowlist. O download deriva o `Content-Type` da allowlist, nunca
  /// ecoando este valor diretamente.
  mimeType        String
  /// Tamanho em bytes.
  tamanho         Int

  createdAt DateTime @default(now())

  @@index([registroId])
  @@map("instalacao_registro_anexos")
}

/// Custo extra pertencente a um acontecimento (Sprint 4.0.2).
/// Custo interno operacional: NÃO altera a Proposta nem gera cobrança.
model InstalacaoCusto {
  id String @id @default(cuid())

  registroId String
  registro   InstalacaoRegistro @relation(fields: [registroId], references: [id], onDelete: Cascade)

  categoria CategoriaCustoInstalacao
  descricao String?
  /// Monetário: Decimal, NUNCA Float. Sempre > 0 (validado no Zod e no service).
  valor     Decimal                  @db.Decimal(12, 2)

  createdAt DateTime @default(now())

  @@index([registroId])
  @@map("instalacao_custos")
}

// ---------------------------------------------------------------------------
// Pós-venda (Sprint 4.6) — Troca Antecipada e Ordem de Serviço
// ---------------------------------------------------------------------------
//
// DOIS processos distintos, deliberadamente separados (ADR-0418):
//
//   Troca Antecipada  responde "o produto defeituoso voltou?"
//   Ordem de Serviço  responde "qual era o defeito, e o que foi feito?"
//
// A OS **existe sem Troca** — uma peça pode chegar para conserto sem nunca ter
// havido envio antecipado. Modelar as duas como uma coisa só forçaria uma Troca
// fantasma para toda análise técnica.
//
// NÃO reutiliza `Instalacao`: os padrões de UX e de arquitetura são copiados,
// as entidades e regras são próprias.
//
// **Esta OS é de PÓS-VENDA / MANUTENÇÃO DE EQUIPAMENTOS.** Não confundir com
// uma futura OS de instalação, que será outra entidade.

/// Estado operacional da Troca Antecipada. Sem máquina de estados rígida —
/// qualquer transição é permitida, como em `StatusInstalacao`.
///
/// `VALOR_PENDENTE` é status **operacional**, não financeiro: sinaliza que
/// alguém precisa decidir o que fazer com um valor. O módulo não cria conta a
/// pagar, cobrança nem baixa (fora de escopo por decisão da Sprint).
enum StatusTrocaAntecipada {
  ABERTA
  ENVIO_PENDENTE
  DEVOLUCAO_PENDENTE
  EM_ANALISE
  VALOR_PENDENTE
  FINALIZADA
  CANCELADA
}

/// Para quem o produto substituto foi enviado.
///
/// `CLIENTE` usa o próprio Cliente da Troca como referência visual e dispensa
/// `destinatarioNome`. `INSTALADOR` e `OUTRO` exigem o nome/descrição — NÃO há
/// cadastro de parceiro/instalador nesta Sprint, de propósito.
enum DestinatarioTroca {
  CLIENTE
  INSTALADOR
  OUTRO
}

/// Estado operacional da Ordem de Serviço de pós-venda. Também sem workflow
/// rígido.
enum StatusOrdemServicoPosVenda {
  ABERTA
  AGUARDANDO_ANALISE
  EM_ANALISE
  EM_MANUTENCAO
  AGUARDANDO_PECA
  FINALIZADA
  CANCELADA
}

/// Categoria do custo operacional do Pós-venda — UMA enum para os dois
/// submódulos (ADR-0418).
///
/// A Troca oferece as categorias de ENVIO (motoboy, sedex, frete, visita); a OS
/// oferece as de REPARO (peça, material, terceirização). A restrição é da
/// interface, em `CATEGORIAS_CUSTO_TROCA` / `CATEGORIAS_CUSTO_OS`.
///
/// Duas enums no banco obrigariam a duplicar o módulo de cálculo e a tabela de
/// rótulos para ganhar uma garantia que o Select já dá.
///
/// **Custos da Troca e da OS nunca se somam.** São históricos independentes:
/// nenhuma tela exibe um total combinado, e criar a OS a partir da Troca não
/// copia custo algum.
enum CategoriaCustoPosVenda {
  MOTOBOY
  SEDEX
  FRETE
  VISITA
  PECA
  MATERIAL
  TERCEIRIZACAO
  OUTROS
}

/// Trilha TÉCNICA do Pós-venda, compartilhada por Troca e OS. Não confundir com
/// a timeline operacional (`*Registro`) — ver ADR-0401, que vale igual aqui.
///
/// `VINCULO` registra, nos DOIS lados, a criação de uma OS a partir de uma
/// Troca.
enum EventoPosVenda {
  CRIACAO
  ALTERACAO
  MUDANCA_STATUS
  FINALIZACAO
  CANCELAMENTO
  VINCULO
}

/// Troca Antecipada — raiz do agregado de controle de devolução.
///
/// Controle operacional SEPARADO da Instalação. Nasce quando a empresa decide
/// enviar o substituto antes de receber o defeituoso, e fecha quando o retorno
/// está resolvido — resolvido inclui "não vai voltar", por decisão registrada.
model TrocaAntecipada {
  id String @id @default(cuid())

  /// Numeração OPERACIONAL própria (sequência do PostgreSQL, inicia em 1001).
  /// Nunca o `id`, nunca `MAX(numero)+1` — mesmo padrão do ADR-0201.
  numero Int @unique @default(autoincrement())

  clienteId String
  cliente   Cliente @relation(fields: [clienteId], references: [id], onDelete: Restrict)

  /// Identificação operacional curta, dada pelo usuário. É o texto principal da
  /// listagem: "Fechadura entrada social", "7 interruptores sala/cozinha".
  /// Obrigatória — sem ela a linha da tabela não diz nada.
  referencia String

  /// Responsável ATUAL — estado corrente, não fato histórico. Renomear o
  /// Usuário DEVE refletir aqui; por isso não há snapshot textual (ADR-0408).
  /// Papel exigido: `ehTecnico` (ADR-0410). Nenhum papel novo foi criado.
  responsavelId String?
  responsavel   Usuario? @relation("TrocaResponsavel", fields: [responsavelId], references: [id], onDelete: Restrict)

  /// O que o cliente relatou. Opcional: a Troca pode ser aberta com o mínimo e
  /// ganhar contexto pela timeline.
  relatoInicial String? @db.Text

  status StatusTrocaAntecipada @default(ABERTA)

  destinatarioTipo DestinatarioTroca @default(CLIENTE)
  /// Obrigatório quando o destinatário é INSTALADOR ou OUTRO (validado no Zod e
  /// no service). Ignorado quando é CLIENTE.
  destinatarioNome String?

  /// Conclusão registrada dentro da própria Troca. OPCIONAL e nunca bloqueia a
  /// finalização — a análise técnica principal acontece depois, na OS.
  diagnosticoConclusao String? @db.Text

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  /// Carimbados na transição, nunca sobrescritos. Mesma regra de
  /// `Proposta.emitidaAt`/`canceladaAt`.
  finalizadaEm DateTime?
  canceladaEm  DateTime?

  itens      TrocaAntecipadaItem[]
  registros  TrocaAntecipadaRegistro[]
  auditorias TrocaAntecipadaAuditoria[]

  /// Zero ou UMA OS principal (ADR-0419). A cardinalidade é garantida pelo
  /// `@unique` do lado da OS, não por código. Múltiplas OS por Troca ficaram no
  /// BACKLOG; quando entrarem, basta remover o unique — migration aditiva.
  ordemServico OrdemServicoPosVenda?

  @@index([clienteId])
  @@index([responsavelId])
  @@index([status])
  @@index([updatedAt])
  @@map("pos_venda_trocas")
}

/// Produto que participa da Troca.
///
/// **`produtoId` OU `descricaoManual` — nunca os dois vazios.** A regra vive em
/// `features/pos-venda/itens.ts` (módulo puro), é aplicada no Zod e DE NOVO no
/// service; a segunda é a que vale, porque a primeira depende de quem chamou.
///
/// **Sem snapshot de código/descrição, de propósito.** Diferente de
/// `PropostaItem` (ADR-0207), que congela preço porque é documento comercial
/// assinável, o item de pós-venda não tem preço e não vai para documento
/// nenhum: a pergunta é *qual peça é esta*, e a resposta é sobre o cadastro
/// ATUAL. Renomear um produto deve refletir na Troca aberta.
model TrocaAntecipadaItem {
  id String @id @default(cuid())

  trocaAntecipadaId String
  troca             TrocaAntecipada @relation(fields: [trocaAntecipadaId], references: [id], onDelete: Cascade)

  /// Vínculo com o cadastro. RESTRICT: produto usado não é excluído (ADR-0104).
  /// O id REAL é preservado — é o que torna possível analisar defeito recorrente
  /// por produto no futuro, e o que a criação semiautomática da OS copia.
  produtoId String?
  produto   Produto? @relation(fields: [produtoId], references: [id], onDelete: Restrict)

  /// Preenchida quando o produto não está no cadastro ("Outro").
  descricaoManual String?

  /// Inteiros, sempre >= 0. `quantidadeDevolvida` nunca excede
  /// `quantidadeEsperadaRetorno` (validado no Zod e no service).
  quantidadeEnviada         Int @default(0)
  quantidadeEsperadaRetorno Int @default(0)
  quantidadeDevolvida       Int @default(0)

  /// NÃO existe coluna de pendência: `max(esperada - devolvida, 0)` é derivado
  /// no módulo puro. Persistir um valor calculável é criar uma segunda verdade.

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([trocaAntecipadaId])
  @@index([produtoId])
  @@map("pos_venda_troca_itens")
}

/// Acontecimento da timeline da Troca.
///
/// É CONTEÚDO escrito pelos responsáveis, não trilha de sistema — não confundir
/// com `TrocaAntecipadaAuditoria` (ADR-0401). Criar, editar ou excluir um
/// registro NÃO gera entrada de auditoria.
model TrocaAntecipadaRegistro {
  id String @id @default(cuid())

  trocaAntecipadaId String
  troca             TrocaAntecipada @relation(fields: [trocaAntecipadaId], references: [id], onDelete: Cascade)

  /// Quando o fato OCORREU. Pode ser anterior à criação da Troca (fatos
  /// históricos são permitidos). A timeline ordena por este campo.
  dataHora DateTime

  responsavelId String
  responsavel   Usuario @relation("TrocaRegistroResponsavel", fields: [responsavelId], references: [id], onDelete: Restrict)

  /// Snapshot do nome do responsável no momento em que ELE foi atribuído a este
  /// registro — derivado NO SERVICE, nunca recebido do navegador (ADR-0408).
  /// Só é reescrito quando o `responsavelId` muda.
  responsavelNome String

  relato String @db.Text

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  custos TrocaAntecipadaRegistroCusto[]
  anexos TrocaAntecipadaRegistroAnexo[]

  @@index([trocaAntecipadaId, dataHora])
  @@index([responsavelId])
  @@map("pos_venda_troca_registros")
}

/// Custo operacional pertencente a um acontecimento da Troca.
/// Interno: NÃO altera proposta, NÃO gera cobrança, NÃO soma com a OS.
model TrocaAntecipadaRegistroCusto {
  id String @id @default(cuid())

  registroId String
  registro   TrocaAntecipadaRegistro @relation(fields: [registroId], references: [id], onDelete: Cascade)

  categoria CategoriaCustoPosVenda
  descricao String?
  /// Monetário: Decimal, NUNCA Float. Sempre > 0 (Zod e service).
  valor     Decimal                @db.Decimal(12, 2)

  createdAt DateTime @default(now())

  @@index([registroId])
  @@map("pos_venda_troca_custos")
}

/// Arquivo anexado a um acontecimento da Troca. Mesma arquitetura do ADR-0414,
/// com entidade PRÓPRIA — nenhuma FK aponta para `Instalacao`.
///
/// **O banco é a autoridade.** Arquivo órfão em disco é tolerado e logável;
/// linha apontando para arquivo inexistente é o estado a evitar.
model TrocaAntecipadaRegistroAnexo {
  id String @id @default(cuid())

  registroId String
  registro   TrocaAntecipadaRegistro @relation(fields: [registroId], references: [id], onDelete: Cascade)

  /// Nome que o usuário enviou. Exibição e `Content-Disposition` apenas —
  /// **NUNCA** participa da construção de um caminho físico.
  nomeOriginal    String
  /// Chave física gerada no SERVIDOR: `<aleatório>.<ext>`, com a extensão vinda
  /// da allowlist de MIME, nunca do nome enviado pelo navegador.
  nomeArmazenado  String
  /// Caminho RELATIVO a `storagePaths.upload`, com separadores POSIX.
  caminhoRelativo String
  /// MIME da allowlist. O download deriva o `Content-Type` da allowlist.
  mimeType        String
  tamanho         Int

  createdAt DateTime @default(now())

  @@index([registroId])
  @@map("pos_venda_troca_anexos")
}

/// Trilha técnica da Troca. Gravada na MESMA transação da escrita.
model TrocaAntecipadaAuditoria {
  id String @id @default(cuid())

  trocaAntecipadaId String
  troca             TrocaAntecipada @relation(fields: [trocaAntecipadaId], references: [id], onDelete: Cascade)

  evento     EventoPosVenda
  observacao String?        @db.Text

  createdAt DateTime @default(now())

  @@index([trocaAntecipadaId])
  @@map("pos_venda_troca_auditorias")
}

/// Ordem de Serviço de PÓS-VENDA / MANUTENÇÃO DE EQUIPAMENTOS.
///
/// **Não confundir com uma futura OS de instalação.** Esta existe para
/// analisar, reparar e registrar o histórico técnico de produtos que voltaram.
///
/// Funciona COMPLETAMENTE sem Troca Antecipada: a criação manual é o fluxo
/// obrigatório, e `trocaAntecipadaId` é opcional.
model OrdemServicoPosVenda {
  id String @id @default(cuid())

  /// Numeração própria, sequência independente da Troca, inicia em 1001.
  numero Int @unique @default(autoincrement())

  clienteId String
  cliente   Cliente @relation(fields: [clienteId], references: [id], onDelete: Restrict)

  /// Vínculo OPCIONAL com a Troca que originou esta OS (ADR-0419).
  ///
  /// `@unique` = uma Troca tem ZERO OU UMA OS. A cardinalidade mora no banco,
  /// não em código: é a única forma de a regra não depender de quem escreve.
  ///
  /// RESTRICT: apagar a Troca não pode arrastar a OS junto. Na prática Troca
  /// não é apagada (é cancelada), mas a FK não depende disso.
  ///
  /// **NÃO existe coluna `origem`.** A origem é DERIVADA deste campo: nulo =
  /// DIRETA, preenchido = TROCA_ANTECIPADA. Uma coluna seria um segundo lugar
  /// onde a mesma verdade mora, e no dia em que divergisse do vínculo não
  /// haveria como saber qual das duas está certa.
  trocaAntecipadaId String?          @unique
  trocaAntecipada   TrocaAntecipada? @relation(fields: [trocaAntecipadaId], references: [id], onDelete: Restrict)

  /// Identificação operacional curta. Obrigatória, como na Troca.
  referencia String

  responsavelId String?
  responsavel   Usuario? @relation("OrdemServicoResponsavel", fields: [responsavelId], references: [id], onDelete: Restrict)

  relatoInicial String? @db.Text

  status StatusOrdemServicoPosVenda @default(ABERTA)

  /// Conclusão técnica geral. Opcional durante a execução; na FINALIZAÇÃO,
  /// preencher isto OU o diagnóstico/solução de ao menos um item é exigido
  /// (ADR-0420) — a OS existe justamente para registrar isso.
  diagnosticoConclusao String? @db.Text

  createdAt    DateTime  @default(now())
  updatedAt    DateTime  @updatedAt
  finalizadaEm DateTime?
  canceladaEm  DateTime?

  itens      OrdemServicoPosVendaItem[]
  registros  OrdemServicoPosVendaRegistro[]
  auditorias OrdemServicoPosVendaAuditoria[]

  @@index([clienteId])
  @@index([responsavelId])
  @@index([status])
  @@index([updatedAt])
  @@map("pos_venda_ordens_servico")
}

/// Produto analisado/reparado na OS. Mesma regra XOR do item da Troca.
///
/// Quando a OS nasce de uma Troca, este item é um SNAPSHOT do momento da
/// criação: `quantidade` recebe a `quantidadeDevolvida` de então. Alterações
/// posteriores na Troca NÃO chegam aqui — e não existe código de sincronização
/// para desligar, que é o que torna a garantia real (ADR-0419).
model OrdemServicoPosVendaItem {
  id String @id @default(cuid())

  ordemServicoId String
  ordemServico   OrdemServicoPosVenda @relation(fields: [ordemServicoId], references: [id], onDelete: Cascade)

  produtoId String?
  produto   Produto? @relation(fields: [produtoId], references: [id], onDelete: Restrict)

  descricaoManual String?

  /// Inteiro, sempre > 0 — item de OS com quantidade zero não é item.
  quantidade Int @default(1)

  /// O que foi ENCONTRADO e o que foi FEITO, por peça. Opcionais durante a
  /// execução; participam da guarda de finalização (ADR-0420).
  diagnosticoItem String? @db.Text
  solucaoItem     String? @db.Text

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([ordemServicoId])
  @@index([produtoId])
  @@map("pos_venda_os_itens")
}

/// Acontecimento da timeline da OS. Conteúdo, não trilha de sistema.
model OrdemServicoPosVendaRegistro {
  id String @id @default(cuid())

  ordemServicoId String
  ordemServico   OrdemServicoPosVenda @relation(fields: [ordemServicoId], references: [id], onDelete: Cascade)

  dataHora DateTime

  responsavelId String
  responsavel   Usuario @relation("OrdemServicoRegistroResponsavel", fields: [responsavelId], references: [id], onDelete: Restrict)

  /// Snapshot derivado no service, reescrito só quando o responsável muda.
  responsavelNome String

  relato String @db.Text

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  custos OrdemServicoPosVendaRegistroCusto[]
  anexos OrdemServicoPosVendaRegistroAnexo[]

  @@index([ordemServicoId, dataHora])
  @@index([responsavelId])
  @@map("pos_venda_os_registros")
}

/// Custo próprio da OS. NUNCA copiado da Troca, NUNCA somado com ela.
model OrdemServicoPosVendaRegistroCusto {
  id String @id @default(cuid())

  registroId String
  registro   OrdemServicoPosVendaRegistro @relation(fields: [registroId], references: [id], onDelete: Cascade)

  categoria CategoriaCustoPosVenda
  descricao String?
  valor     Decimal                @db.Decimal(12, 2)

  createdAt DateTime @default(now())

  @@index([registroId])
  @@map("pos_venda_os_custos")
}

/// Arquivo anexado a um acontecimento da OS. Entidade própria; mesmas regras.
model OrdemServicoPosVendaRegistroAnexo {
  id String @id @default(cuid())

  registroId String
  registro   OrdemServicoPosVendaRegistro @relation(fields: [registroId], references: [id], onDelete: Cascade)

  nomeOriginal    String
  nomeArmazenado  String
  caminhoRelativo String
  mimeType        String
  tamanho         Int

  createdAt DateTime @default(now())

  @@index([registroId])
  @@map("pos_venda_os_anexos")
}

/// Trilha técnica da OS.
model OrdemServicoPosVendaAuditoria {
  id String @id @default(cuid())

  ordemServicoId String
  ordemServico   OrdemServicoPosVenda @relation(fields: [ordemServicoId], references: [id], onDelete: Cascade)

  evento     EventoPosVenda
  observacao String?        @db.Text

  createdAt DateTime @default(now())

  @@index([ordemServicoId])
  @@map("pos_venda_os_auditorias")
}
